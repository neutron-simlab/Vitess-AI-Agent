# Copy to .env and fill in. .env is never committed.

# Postgres. Required: docker-compose.yml refuses to start without it.
POSTGRES_PASSWORD=
# POSTGRES_USER=vitess
# POSTGRES_DB=vitess

# At least one model provider. Without one the service refuses to start.
BLABLADOR_API_KEY=
# OPENAI_API_KEY=
# Retrieval still needs BLABLADOR_API_KEY even when chat uses OpenAI, because
# the persisted VITESS index uses the Blablador embedding model.
VITESS_RAG_EMBEDDING_MODEL=alias-qwen3-8b-embeddings

# Optional LangSmith tracing. When enabled, agent, model and tool-call traces
# are sent to the configured LangSmith service.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vitess-ai
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Bound the embedding call made by each documentation lookup. These are
# separate from the chat-model timeout and retry settings.
# VITESS_RAG_QUERY_TIMEOUT_SECONDS=20
# VITESS_RAG_MAX_RETRIES=1

# Where the Streamlit UI is published on the host, loopback only.
# UI_PORT=9601

# How long one VITESS pipeline may run before the MCP server stops it.
# VITESS_SIMULATION_TIMEOUT_SECONDS=3600

# LOG_LEVEL=INFO
