# =============================================================================
# VITESS AI AGENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Remove the .example extension: cp .env.example .env
#
# CUSTOM ENV PATH SUPPORT:
# Set VITESS_ENV_PATH environment variable to load .env from custom location:
# export VITESS_ENV_PATH=/path/to/your/.env
# This allows keeping sensitive configs outside your project directory

# =============================================================================
# CORE API KEYS (REQUIRED)
# =============================================================================

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Default provider to use (openai, blablador)
DEFAULT_PROVIDER=openai

# Fallback provider if default fails
FALLBACK_PROVIDER=blablador

# Default OpenAI model
DEFAULT_MODEL=gpt-4o-mini-2024-07-18

# LLM request settings
MAX_TOKENS=4000
TIMEOUT_SECONDS=60
MAX_RETRIES=3

# =============================================================================
# BLABLADOR SETTINGS (Optional - OpenAI-compatible API)
# =============================================================================

# Blablador API credentials
BLABLADOR_API_KEY=your-blablador-api-key-here
BLABLADOR_BASE_URL=https://api.helmholtz-blablador.fz-juelich.de/v1/
BLABLADOR_DEFAULT_MODEL=alias-fast-experiment

# =============================================================================
# LANGSMITH SETTINGS (Optional but recommended for tracing)
# =============================================================================

# Enable LangSmith tracing for debugging and monitoring
LANGSMITH_TRACING=false

# LangSmith configuration (only needed if LANGSMITH_TRACING=true)
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=Vitess-AI-Agent

# =============================================================================
# MCP TOOL PATHS (OPTIONAL - Defaults provided, override if needed)
# =============================================================================
# These paths are used by:
# - docker-entrypoint.sh: To start MCP servers in HTTP mode (production)
# - Supervisor agent: To spawn MCP subprocesses in stdio mode (development)
# 
# Defaults match the standard project structure and are set in:
# - config.py (for supervisor agent)
# - docker-entrypoint.sh (for MCP server startup)
# 
# Only override if your project structure differs from the standard layout.

# Path to read-in module MCP tools
READIN_MCP_PATH=./src/vitess_ai/mcp/readin_module_tools.py

# Path to guide module MCP tools  
GUIDE_MCP_PATH=./src/vitess_ai/mcp/guide_module_tools.py

# Path to writeout module MCP tools
WRITEOUT_MCP_PATH=./src/vitess_ai/mcp/writeout_module_tools.py

# Path to monitor module MCP tools
MONITOR_MCP_PATH=./src/vitess_ai/mcp/monitor_module_tools.py

# Path to filter module MCP tools
FILTER_MCP_PATH=./src/vitess_ai/mcp/filter_module_tools.py

# Path to supervisor CLI MCP tools
SUPERVISOR_MCP_PATH=./src/vitess_ai/mcp/supervisor_tools.py

# =============================================================================
# MCP TRANSPORT CONFIGURATION
# =============================================================================

# MCP transport mode: "stdio" for local development, "http" for production/deployment
# HTTP mode runs MCP servers as HTTP services on dedicated ports
MCP_TRANSPORT_MODE=http

# MCP server host (for client connections)
# Use "localhost" in Docker, "127.0.0.1" for local development
MCP_HOST=localhost

# MCP server ports (defaults match the ports configured in server files)
MCP_READIN_PORT=9001
MCP_GUIDE_PORT=9002
MCP_WRITEOUT_PORT=9003
MCP_MONITOR_PORT=9004
MCP_SUPERVISOR_PORT=9005

# Optional: Override MCP server URLs directly (if not set, URLs are constructed from host and ports)
# MCP_READIN_URL=http://localhost:9001
# MCP_GUIDE_URL=http://localhost:9002
# MCP_WRITEOUT_URL=http://localhost:9003
# MCP_MONITOR_URL=http://localhost:9004
# MCP_SUPERVISOR_URL=http://localhost:9005

# =============================================================================
# VITESS SIMULATION ENVIRONMENT (REQUIRED - Neutron experiment simulation paths)
# =============================================================================
#
# IMPORTANT: Docker vs Local Development
#
# When using Docker (docker-compose):
#   - These variables are AUTOMATICALLY set by docker-compose.yml
#   - Container paths: /vitess/MODULES, /data/projects, /data/logs/logfile.log
#   - You do NOT need to set these in .env - they're injected by Docker
#
# For local development (without Docker):
#   - Set these to your actual host paths where Vitess is installed
#   - VITESS_MODULES_PATH: Path to Vitess software modules directory
#   - VITESS_PROJECT_PATH: Path to your neutron experiment project directory
#   - VITESS_LOG_PATH: Path to Vitess log file (must be a file path, not a directory)
#
# Example for local development:
#   VITESS_MODULES_PATH=/usr/local/vitess/MODULES
#   VITESS_PROJECT_PATH=/home/user/my-vitess-project
#   VITESS_LOG_PATH=/home/user/vitess-logs/vitess.log

# Vitess modules installation path
# For Docker: Automatically set to /vitess/MODULES (no need to configure)
# For local: Set to your Vitess modules directory on the host
VITESS_MODULES_PATH=/path/to/vitess/MODULES

# Vitess project directory path
# For Docker: Automatically set to /data/projects (no need to configure)
# For local: Set to your neutron experiment project directory on the host
VITESS_PROJECT_PATH=/path/to/your/vitess/project

# Vitess log file path (must be a file path, not a directory)
# For Docker: Automatically set to /data/logs/logfile.log (no need to configure)
# For local: Set to your desired log file path on the host
VITESS_LOG_PATH=/path/to/vitess/logfile.log

# =============================================================================
# ENVIRONMENT SETTINGS (OPTIONAL - Currently not actively used)
# =============================================================================
# Note: These variables are defined but not currently used to control behavior.
# They may be used in future versions for environment-specific configurations.

# Environment mode (development, staging, production)
# Currently only used for informational display at startup
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Currently not used - logging is hardcoded to INFO throughout the codebase
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# To get started:
# 1. Copy this file: cp .env.example .env
# 2. Get OpenAI API key from: https://platform.openai.com/api-keys
# 3. Update MCP tool paths to match your project structure
# 4. Set up your Vitess simulation environment paths:
#    - VITESS_MODULES_PATH: Point to Vitess installation
#    - VITESS_PROJECT_PATH: Point to your neutron experiment project
#    - VITESS_LOG_PATH: Point to desired log file path (imaginary file name)
# 5. (Optional) Set up LangSmith for tracing: https://smith.langchain.com/
# 6. (Optional) Configure Blablador if you have access

# For neutron experiment simulations:
# - Ensure Vitess is properly installed and accessible
# - Verify all Vitess paths exist and log file path is properly configured
# - Test your Vitess environment before running AI agents
# - Check that your neutron experiment files are in the project path

# For production:
# - Set ENVIRONMENT=production
# - Consider enabling LANGSMITH_TRACING=true for monitoring
# - Use secure methods to set API keys (don't commit .env to git!)
# - Ensure Vitess paths are properly configured and log file path is set correctly

# Security reminder:
# - Never commit your .env file to version control
# - Add .env to your .gitignore file
# - Use environment-specific files (.env.development, .env.production)
# - In production, use secure secret management instead of .env files
# - Ensure Vitess directories have appropriate permissions