# Copy to .env and fill in. .env is never committed.

# Postgres. Required: docker-compose.yml refuses to start without it.
POSTGRES_PASSWORD=
# POSTGRES_USER=vitess
# POSTGRES_DB=vitess

# Where the Streamlit UI is published on the host, loopback only.
# UI_PORT=9601

# How long one VITESS pipeline may run before the MCP server stops it.
# VITESS_SIMULATION_TIMEOUT_SECONDS=3600

# LOG_LEVEL=INFO
