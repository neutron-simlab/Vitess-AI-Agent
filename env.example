# =============================================================================
# VITESS AI AGENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Remove the .example extension: cp .env.example .env
#
# CUSTOM ENV PATH SUPPORT:
# Set VITESS_ENV_PATH environment variable to load .env from custom location:
# export VITESS_ENV_PATH=/path/to/your/.env
# This allows keeping sensitive configs outside your project directory

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
#
# HOW IT WORKS:
# The system automatically detects which providers you've configured and only uses
# those with valid API keys. Configure only the providers you want to use.
#
# Quick Start:
#   1. Choose one or more providers below (OpenAI, Blablador, or both)
#   2. Set their API keys/credentials
#   3. Optionally set DEFAULT_PROVIDER (auto-adjusts if unavailable)
#   4. The system will automatically adapt - UI shows only configured providers
#
# Examples:
#   • Only Blablador configured → System uses Blablador only, UI shows only Blablador
#   • Only OpenAI configured → System uses OpenAI only, UI shows only OpenAI  
#   • Both configured → System uses DEFAULT_PROVIDER, both appear in UI
#   • DEFAULT_PROVIDER unavailable → Auto-adjusts to first available provider
#
# Future providers (Gemini, Anthropic, etc.) will be automatically detected
# when added to the codebase - just configure their API keys here.

# -----------------------------------------------------------------------------
# PROVIDER API KEYS & CREDENTIALS
# -----------------------------------------------------------------------------
# Configure at least one provider by setting its API keys below.
# Providers without API keys won't appear in the UI and won't be used.

# OpenAI Provider
# Get API key from: https://platform.openai.com/api-keys
# Default model: gpt-4o-mini
# Available models: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Optional: Filter which OpenAI models appear in the sidebar UI
# Comma-separated list of model names. If not set, all models are shown.
# OPENAI_AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4-turbo,gpt-3.5-turbo

# Blablador Provider (OpenAI-compatible API)
# Configure both API key and base URL to enable Blablador
BLABLADOR_API_KEY=your-blablador-api-key-here
BLABLADOR_BASE_URL=https://api.helmholtz-blablador.fz-juelich.de/v1/
BLABLADOR_DEFAULT_MODEL="01 - GPT-OSS-120b - an open model released by OpenAI in August 2025"

# Optional: Filter which Blablador models appear in the sidebar UI
# Comma-separated list of model names. If not set, all models are shown.
# BLABLADOR_AVAILABLE_MODELS=01 - GPT-OSS-120b - an open model released by OpenAI in August 2025,01 - MiniMax-M2.7 - our best model as of April, 2026

# -----------------------------------------------------------------------------
# PROVIDER SELECTION & DEFAULTS
# -----------------------------------------------------------------------------
# These settings control which provider to use by default.
# The system will auto-adjust if your selected provider isn't configured.

# Default provider to use (must be one of: openai, blablador)
# If this provider isn't configured, system auto-adjusts to first available provider
DEFAULT_PROVIDER=blablador

# Fallback provider if default fails (optional)
# If this provider isn't configured, fallback is automatically disabled
FALLBACK_PROVIDER=openai

# -----------------------------------------------------------------------------
# LLM REQUEST SETTINGS
# -----------------------------------------------------------------------------
# These settings apply to all providers

TIMEOUT_SECONDS=120
MAX_RETRIES=3


# =============================================================================
# LANGSMITH SETTINGS (Optional but recommended for tracing)
# =============================================================================

# Enable LangSmith tracing for debugging and monitoring
LANGSMITH_TRACING=false

# LangSmith configuration (only needed if LANGSMITH_TRACING=true)
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=Vitess-AI-Agent

# =============================================================================
# MCP TOOL PATHS (OPTIONAL - Defaults provided, override if needed)
# =============================================================================
# These paths are used by:
# - docker-entrypoint.sh: To start MCP servers in HTTP mode (production)
# - Supervisor agent: To spawn MCP subprocesses in stdio mode (development)
# 
# Defaults match the standard project structure and are set in:
# - config.py (for supervisor agent)
# - docker-entrypoint.sh (for MCP server startup)
# 
# Only override if your project structure differs from the standard layout.

# Path to supervisor CLI MCP tools
SUPERVISOR_MCP_PATH=./src/vitess_ai/mcp/supervisor_tools.py

# =============================================================================
# MCP TRANSPORT CONFIGURATION
# =============================================================================

# MCP transport mode: "stdio" for local development, "http" for production/deployment
# HTTP mode runs MCP servers as HTTP services on dedicated ports
MCP_TRANSPORT_MODE=http

# MCP server host (for client connections)
# Use "localhost" in Docker, "127.0.0.1" for local development
MCP_HOST=localhost

# MCP server ports (defaults match the ports configured in server files)
MCP_SUPERVISOR_PORT=9005

# Optional: Override MCP server URLs directly (if not set, URLs are constructed from host and ports)
# MCP_SUPERVISOR_URL=http://localhost:9005

# =============================================================================
# VITESS DOCUMENTATION RAG
# =============================================================================

VITESS_RAG_ENABLED=true
VITESS_RAG_DATA_DIR=rag/vitess-rag/data
VITESS_RAG_PERSIST_PATH=/data/rag/chroma_db
VITESS_RAG_COLLECTION=vitess_docs
VITESS_RAG_EMBEDDING_MODEL=alias-embeddings
VITESS_RAG_REINDEX=false


# =============================================================================
# ENVIRONMENT SETTINGS (OPTIONAL - Currently not actively used)
# =============================================================================
# Note: These variables are defined but not currently used to control behavior.
# They may be used in future versions for environment-specific configurations.

# Environment mode (development, staging, production)
# Currently only used for informational display at startup
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Currently not used - logging is hardcoded to INFO throughout the codebase
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# To get started:
# 1. Copy this file: cp .env.example .env
# 2. Get LLM provider API keys (OpenAI, Blablador, etc.) - see provider sections above
# 3. Update MCP tool paths to match your project structure
# 4. (Optional) Set up LangSmith for tracing: https://smith.langchain.com/
# 5. Configure at least one LLM provider (OpenAI, Blablador, etc.)

# For neutron experiment simulations:
# - Ensure Vitess is properly installed and accessible
# - Verify all Vitess paths exist and log file path is properly configured
# - Test your Vitess environment before running AI agents
# - Check that your neutron experiment files are in the project path

# For production:
# - Set ENVIRONMENT=production
# - Consider enabling LANGSMITH_TRACING=true for monitoring
# - Use secure methods to set API keys (don't commit .env to git!)
# - Ensure Vitess paths are properly configured and log file path is set correctly

# Security reminder:
# - Never commit your .env file to version control
# - Add .env to your .gitignore file
# - Use environment-specific files (.env.development, .env.production)
# - In production, use secure secret management instead of .env files
# - Ensure Vitess directories have appropriate permissions
